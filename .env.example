# ---- Frontend (public, bundled into the browser) ----
# Leave empty to run in 本機模式 (local mode): data is stored only in this browser.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ---- Server only (Vercel Functions). NEVER prefix with VITE_ ----
# `npm run dev` also serves api/ locally (vite-dev-api.ts) and reads these from .env.local;
# SUPABASE_URL / SUPABASE_ANON_KEY fall back to the VITE_ values in dev.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Requests per user per minute for /api/chat
AI_RATE_LIMIT_PER_MINUTE=10
# Optional: vision model for /api/timetable-import (defaults to OPENAI_MODEL)
OPENAI_VISION_MODEL=
