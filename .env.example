# ---- Frontend (public, bundled into the browser) ----
# Leave empty to run in 本機模式 (local mode): data is stored only in this browser.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ---- Server only (Vercel Functions). NEVER prefix with VITE_ ----
# `npm run dev` also serves api/ locally (vite-dev-api.ts) and reads these from .env.local;
# SUPABASE_URL / SUPABASE_ANON_KEY fall back to the VITE_ values in dev.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Web Push (reminders) and cron authentication
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
CRON_SECRET=
# No AI / translation API keys are needed: the assistant, timetable OCR and translations run on the device.
