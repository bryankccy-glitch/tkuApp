{
  "name": "tku-campus-os",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/copy-ocr-assets.mjs && vite",
    "build": "node scripts/copy-ocr-assets.mjs && tsc -b && vite build",
    "preview": "vite preview",
    "build:preview": "node scripts/copy-ocr-assets.mjs && PREVIEW_BUILD=1 VITE_HASH_ROUTER=1 VITE_PREVIEW_DEMO=1 vite build --outDir dist-preview",
    "lint": "eslint .",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.1",
    "@supabase/supabase-js": "^2.47.10",
    "@tanstack/react-query": "^5.62.0",
    "@tesseract.js-data/chi_tra": "1.0.0",
    "@vercel/node": "23.0.1",
    "clsx": "^2.1.1",
    "i18next": "^23.16.8",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.468.0",
    "pdfjs-dist": "6.4.299",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.54.0",
    "react-i18next": "^15.1.3",
    "react-markdown": "^9.0.1",
    "react-router-dom": "^6.30.6",
    "tailwind-merge": "^2.5.5",
    "tesseract.js": "7.0.0",
    "web-push": "^3.6.7",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.1",
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.49.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/leaflet": "^1.9.15",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.49",
    "prettier": "^3.4.2",
    "tailwindcss": "^3.4.17",
    "tsx": "4.23.15",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vite": "^6.0.3",
    "vite-plugin-pwa": "^0.21.1",
    "vitest": "^3.0.5"
  }
}
